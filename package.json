{
  "name": "database-systems-slides",
  "private": true,
  "version": "0.1.0",
  "description": "Marp slide deck for Database Systems (511783-001)",
  "scripts": {
    "preview": "marp -s slides --theme-set themes/shintia.css --html",
    "build:html": "marp -I slides --theme-set themes/shintia.css --html --allow-local-files -o dist",
    "build:pdf": "marp -I slides --theme-set themes/shintia.css --html --pdf --allow-local-files -o dist",
    "build:pptx": "marp -I slides --theme-set themes/shintia.css --html --pptx --allow-local-files -o dist"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.0.1"
  }
}
